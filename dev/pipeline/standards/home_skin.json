    "card4_body": {"label": "卡片4 主体", "match": "^(卡片4|card4|bg4|frame0?4).*(主体|身|body|bottom)", "path": "Assets/Arts/UI/Themes/Theme_{id}/Frame04_Bottom.png"},
    "card4_slot": {"label": "卡片4 位置(不导出)", "match": "^(卡片4|card4|bg4).*(位置|slot|占位)", "placeOnly": true, "stage": false},
