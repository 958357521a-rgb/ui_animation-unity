    "card1_body": {"label": "卡片1 主体", "match": "^(卡片1|card1|bg1|frame0?1).*(主体|身|body|bottom)", "path": "Assets/Arts/UI/Themes/Theme_{id}/Frame01_Bottom.png"},
    "card1_slot": {"label": "卡片1 位置(不导出)", "match": "^(卡片1|card1|bg1).*(位置|slot|占位)", "placeOnly": true, "stage": false},
