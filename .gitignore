# 本机口令:每台电脑启动服务时各自生成,不能进仓库
dev/local_token_*.js

# 工程文件内嵌贴图(几十 MB、含游戏美术资源):不进仓库,需要时单独发文件
projects/
# 主工程旧文件备份、导出的交付包和中间产物
backups/
exports/

# 每台电脑自己的 AI 模型配置(按本机显卡选的模型文件名等)
dev/restyle/models.local.json

# 运行时临时文件
__pycache__/
*.pyc
dev/_out/
Thumbs.db
desktop.ini

# Figma 插件配对码、资源批处理的本机设置(主工程路径)
dev/bridge_key.txt
dev/pipeline/settings.local.json

# 其他会话的原始记录归档(含完整对话,只留本机)
docs/会话归档/
